{
  "expo": {
    "name": "V-Care",
    "slug": "v-care",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo - Edited.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo - Edited.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vcare.app"
    },
    "android": {
      "package": "com.vcare.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo - Edited.png",
        "backgroundColor": "#ff6b6b"
      },
      "permissions": [
        "INTERNET",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECORD_AUDIO"
      ],
      "usesCleartextTraffic": false,
      "minSdkVersion": 21,
      "targetSdkVersion": 31
    },
    "web": {
      "favicon": "./assets/logo - Edited.png",
      "bundler": "webpack"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow V-Care to access your photos",
          "cameraPermission": "Allow V-Care to access your camera"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f91c26e1-7840-4591-970f-b5d9770b3142"
      }
    },
    "owner": "botaitrading",
    "description": "V-Care - Blood Donation & Health Community App"
  }
}
